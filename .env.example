# Document360 API Configuration
# Get your API Key from: Document360 Portal -> Settings -> Knowledge Base Portal -> API Token
DOCUMENT360_API_TOKEN=your_api_token_here

# Your User ID (usually a GUID)
DOCUMENT360_USER_ID=your_user_id_here

# These will be automatically discovered by the app if left blank, 
# but you can fix them here if discovery fails.
DOCUMENT360_PROJECT_VERSION_ID=
DOCUMENT360_CATEGORY_ID=

# Base URL for Document360 v2 API
DOCUMENT360_BASE_URL=https://apihub.document360.io
